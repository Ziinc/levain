[package]
name = "{{crate_name}}"
version = "0.1.0"
edition = "2024"
license = "MIT"
publish = false

# The iOS app's Rust half: the Tauri project `levain-pack` builds, whose Xcode
# project links this static library. It is the host (`{{host_crate}}`) and
# nothing else; it exists because a library crate's types can't vary by
# target, and the host's `cdylib` (for Android) can't link for iOS.
# Generated by `levain-pack ios-crate`.
[lib]
name = "{{lib_name}}"
crate-type = ["staticlib"]
test = false
doctest = false

[dependencies]
{{host_crate}} = { path = "{{host_path}}", default-features = false }
tauri = { version = "2.12", default-features = false }

[features]
{{features}}
